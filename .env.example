# Copy this file to .env and fill in your values

GEMINI_API_KEY=your_gemini_api_key_here

# Paths to your local data
CATALOG_CSV_PATH=./data/florence2_descriptions.csv
IMAGE_DIR=./images

# ChromaDB storage directory
CHROMA_DB_PATH=./chroma_fashion_db

# Set to true and provide IMAGE_BASE_URL when deploying with S3
USE_S3=false
IMAGE_BASE_URL=

# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
